# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: Built-in DeepSeek official API key (https://api.deepseek.com)
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# GRSAI_API_KEY: Built-in GRSAI aggregation relay API key (https://grsaiapi.com/v1)
GRSAI_API_KEY="MY_GRSAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
